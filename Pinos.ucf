# Pinos.ucf - Spartan-3A Starter Kit (UG334). All pins checked against the manual.
NET "clk_50MHz" PERIOD = 20 ns;
NET "clk_50MHz" LOC = E12;
NET "clk_50MHz" IOSTANDARD = LVCMOS33;
OFFSET = IN 10 ns VALID 20 ns BEFORE "clk_50MHz";
OFFSET = OUT 20 ns AFTER "clk_50MHz";

# Slide switches SW0..SW3
NET "vetor[0]" LOC = V8;
NET "vetor[0]" IOSTANDARD = LVCMOS33;
NET "vetor[1]" LOC = U10;
NET "vetor[1]" IOSTANDARD = LVCMOS33;
NET "vetor[2]" LOC = U8;
NET "vetor[2]" IOSTANDARD = LVCMOS33;
NET "vetor[3]" LOC = T9;
NET "vetor[3]" IOSTANDARD = LVCMOS33;

# Push-buttons (active HIGH): BTN_EAST = "next step", BTN_SOUTH = reset
NET "botao" LOC = T16;
NET "botao" IOSTANDARD = LVCMOS33;
NET "botao" PULLDOWN;
NET "reset" LOC = T15;
NET "reset" IOSTANDARD = LVCMOS33;
NET "reset" PULLDOWN;

# LED3..LED0 : result (or the switches while entering data)
NET "display_leds[0]" LOC = R20;
NET "display_leds[0]" IOSTANDARD = LVCMOS33;
NET "display_leds[0]" DRIVE = 8;
NET "display_leds[0]" SLEW = SLOW;
NET "display_leds[1]" LOC = T19;
NET "display_leds[1]" IOSTANDARD = LVCMOS33;
NET "display_leds[1]" DRIVE = 8;
NET "display_leds[1]" SLEW = SLOW;
NET "display_leds[2]" LOC = U20;
NET "display_leds[2]" IOSTANDARD = LVCMOS33;
NET "display_leds[2]" DRIVE = 8;
NET "display_leds[2]" SLEW = SLOW;
NET "display_leds[3]" LOC = U19;
NET "display_leds[3]" IOSTANDARD = LVCMOS33;
NET "display_leds[3]" DRIVE = 8;
NET "display_leds[3]" SLEW = SLOW;

# LED7..LED4 : flags Z N C V (or the "entering data" code 11 + step)
NET "flag_Z" LOC = W21;
NET "flag_Z" IOSTANDARD = LVCMOS33;
NET "flag_Z" DRIVE = 8;
NET "flag_Z" SLEW = SLOW;
NET "flag_N" LOC = Y22;
NET "flag_N" IOSTANDARD = LVCMOS33;
NET "flag_N" DRIVE = 8;
NET "flag_N" SLEW = SLOW;
NET "Cout" LOC = V20;
NET "Cout" IOSTANDARD = LVCMOS33;
NET "Cout" DRIVE = 8;
NET "Cout" SLEW = SLOW;
NET "flag_V" LOC = V19;
NET "flag_V" IOSTANDARD = LVCMOS33;
NET "flag_V" DRIVE = 8;
NET "flag_V" SLEW = SLOW;
